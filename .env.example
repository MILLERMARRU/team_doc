# ============================================================
#  Variables de entorno – copia este archivo a .env.local
#  y rellena los valores reales (NUNCA subas .env.local a Git)
# ============================================================

# --- GitHub Storage (repo de docs, puede ser público) ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=tu-usuario-github
GITHUB_REPO=mi-docs
GITHUB_BRANCH=main

# --- Repo de credenciales (usuarios admin) ---
# DEBE ser un repo PRIVADO, separado del repo de docs de arriba.
# El GITHUB_TOKEN debe tener acceso a ambos repos.
CREDENTIALS_GITHUB_OWNER=tu-usuario-github
CREDENTIALS_GITHUB_REPO=mi-docs-credenciales
CREDENTIALS_GITHUB_BRANCH=main

# --- Admin Auth (JSON-based) ---
# Secreto para firmar el JWT de sesión (mín. 32 chars aleatorios)
AUTH_SECRET=cambia-esto-por-un-secreto-muy-largo-y-aleatorio

# --- App URL (opcional, para CORS / callbacks) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Analytics de vistas (opcional) ---
# Se generan automáticamente con:
#   vercel integration add upstash/upstash-kv && vercel env pull .env.local
# No hace falta llenarlas a mano.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example SÍ se commitea: es el template que el README
# le pide a cualquiera que clone el repo que copie a .env.local)
.env*
!.env.example

# credenciales de admin (contiene hashes reales, nunca subir)
/data/users.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
